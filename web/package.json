{
  "name": "screentutor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test test/unit",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\" index.html",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\" index.html"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.3.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bun": "^1.3.3",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
