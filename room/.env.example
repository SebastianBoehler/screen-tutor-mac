# The only required key: the voice tutor (OpenAI Realtime) and, by default, the desk observer.
OPENAI_API_KEY=
# Optional: use a Gemini model via OpenRouter for the desk observer instead (faster).
# OPENROUTER_API_KEY=
# DESK_OBSERVER_MODEL=google/gemini-3.5-flash-lite   (default: gpt-5.4-mini, or Gemini when OPENROUTER_API_KEY is set)
# STUDY_TUTOR_MODEL=gpt-realtime-2.1
# INTERJECTION_COOLDOWN_SECONDS=45
# PORT=3000
# For learners on different networks, add a TURN server:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
